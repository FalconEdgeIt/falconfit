// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  disabled     Boolean  @default(false)
  passwordResetRequestedAt DateTime?
  createdAt    DateTime @default(now())

  groupId String?
  group   Group?  @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  ledGroup Group? @relation("GroupTrainer")

  workoutDays   WorkoutDay[]
  foodEntries   FoodEntry[]
  weightEntries WeightEntry[]
  profile       Profile?
}

model Group {
  id        String @id @default(cuid())
  name      String
  trainerId String @unique
  trainer   User   @relation("GroupTrainer", fields: [trainerId], references: [id])
  members   User[] @relation("GroupMembers")
}

model WorkoutDay {
  id              String     @id @default(cuid())
  name            String
  order           Int        @default(0)
  fromTrainerName String?
  exercises       Exercise[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id         String     @id @default(cuid())
  name       String
  order      Int        @default(0)
  dayId      String
  day        WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  lastWeight Float?
  lastReps   Int?
  lastSets   Int?

  bestWeight Float?
  bestReps   Int?
  bestSets   Int?

  sets       SetLog[]
}

model SetLog {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  weight     Float
  reps       Int
  sets       Int
}

model WeightEntry {
  id     String   @id @default(cuid())
  date   DateTime
  weight Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
model Profile {
  id            String    @id @default(cuid())
  goalWeight    Float?
  birthdate     DateTime?
  heightInches  Float?
  sex           String?
  calorieTarget Float?
  proteinTarget Float?
  carbTarget    Float?
  fatTarget     Float?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model FoodEntry {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  name     String
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
